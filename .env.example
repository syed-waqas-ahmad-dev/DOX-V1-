# OFFLINE MOCK AUTHENTICATION (STRICT DEV/TEST ONLY)
# Explicit opt-in flag required to permit MockDb fallback when MongoDB is unconfigured.
# Disabled by default. Strictly disallowed in production, staging, Vercel preview, and CI environments.
# Set to 'true' ONLY for local offline development without a MongoDB connection.
ALLOW_OFFLINE_MOCK_AUTH=false